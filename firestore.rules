rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-@\\.]+$');
    }

    function isValidEmail(email) {
      return email is string && email.size() >= 3 && email.size() <= 254;
    }

    function isValidUserAccount(data) {
      let allowedKeys = [
        'uid', 'email', 'name', 'handle', 'bio', 'catId', 'avatarUrl', 'bannerUrl',
        'favoriteArtists', 'favoriteGenres', 'followedArtists', 'followingProfiles',
        'likedTracks', 'playlists', 'recentHistory', 'feedPosts', 'customAlbumCovers',
        'onboardingCompleted', 'createdAt', 'updatedAt'
      ];
      return data.keys().hasAll(['uid', 'email', 'name', 'catId', 'createdAt'])
        && data.keys().hasOnly(allowedKeys)
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && isValidEmail(data.email)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && (!('handle' in data) || (data.handle is string && data.handle.size() <= 60))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 300))
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 2000000))
        && (!('bannerUrl' in data) || (data.bannerUrl is string && data.bannerUrl.size() <= 2000000))
        && data.catId is string && data.catId.size() >= 1 && data.catId.size() <= 40
        && (!('favoriteArtists' in data) || (data.favoriteArtists is list && data.favoriteArtists.size() <= 80))
        && (!('favoriteGenres' in data) || (data.favoriteGenres is list && data.favoriteGenres.size() <= 40))
        && (!('followedArtists' in data) || (data.followedArtists is list && data.followedArtists.size() <= 200))
        && (!('followingProfiles' in data) || (data.followingProfiles is list && data.followingProfiles.size() <= 200))
        && (!('likedTracks' in data) || (data.likedTracks is list && data.likedTracks.size() <= 500))
        && (!('playlists' in data) || (data.playlists is list && data.playlists.size() <= 100))
        && (!('recentHistory' in data) || (data.recentHistory is list && data.recentHistory.size() <= 100))
        && (!('feedPosts' in data) || (data.feedPosts is list && data.feedPosts.size() <= 100))
        && (!('customAlbumCovers' in data) || (data.customAlbumCovers is map))
        && (!('onboardingCompleted' in data) || (data.onboardingCompleted is bool))
        && data.createdAt is string && data.createdAt.size() <= 40
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 40));
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserAccount(request.resource.data)
        && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(userId)
        && isValidUserAccount(request.resource.data)
        && request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(userId);
    }

    match /profiles/{profileId} {
      allow read: if true;
      allow create, update: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
