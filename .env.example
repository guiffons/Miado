# PORT: HTTP server port (default: 3000)
PORT=3000

# NODE_ENV: Environment mode (development | production | test)
NODE_ENV=development

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TRUST_PROXY_HOPS: Number of trusted reverse proxy hops for req.ip (0..5)
TRUST_PROXY_HOPS=1

# FRAME_ANCESTORS: Allowed CSP frame-ancestors directive
FRAME_ANCESTORS="'self' https://*.google.com https://*.aistudio.google.com"

# PIPED_INVIDIOUS_INSTANCES: Optional JSON array of audio upstream instances
PIPED_INVIDIOUS_INSTANCES=""
